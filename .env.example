# =============================================================================
# VIDYASHAALE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env. Defaults below work for local Docker development
# (Postgres + Redis in containers, files on the local filesystem).

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (local Postgres via docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=vidyashaale
POSTGRES_PASSWORD=vidyashaale_dev
POSTGRES_DB=vidyashaale
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vidyashaale:vidyashaale_dev@localhost:5432/vidyashaale

# To use InsForge-hosted Postgres instead, replace DATABASE_URL with:
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# -----------------------------------------------------------------------------
# Redis (for notification queue)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret before running
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_PORT=8081
CLASS_PORT=8082
MEETING_PORT=8083
RESOURCE_PORT=8084
NOTIFICATION_PORT=8085
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Google Meet Integration (optional)
# -----------------------------------------------------------------------------
# Leave these as placeholders to disable Google Meet integration.
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8083/auth/google/callback
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# -----------------------------------------------------------------------------
# Email (SMTP) - optional
# -----------------------------------------------------------------------------
# Leave SMTP_HOST blank in dev to log emails to the notification service
# console instead of sending them.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=your-smtp-user
#SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@vidyashaale.com

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Options: LOCAL, S3, INSFORGE
STORAGE_TYPE=LOCAL
STORAGE_BUCKET=vidyashaale

# Local storage (when STORAGE_TYPE=LOCAL)
STORAGE_LOCAL_PATH=./data/uploads

# InsForge storage (when STORAGE_TYPE=INSFORGE)
# Get the URL from .insforge/project.json (oss_host) and the anon key via:
#   npx @insforge/cli secrets get ANON_KEY
#INSFORGE_URL=https://your-project.us-east.insforge.app
#INSFORGE_ANON_KEY=your-insforge-anon-key

# AWS S3 (when STORAGE_TYPE=S3)
#AWS_REGION=us-east-1
#STORAGE_ACCESS_KEY=
#STORAGE_SECRET_KEY=

MAX_FILE_SIZE=52428800

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
API_URL=http://localhost:8080
REACT_APP_API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
