# =============================================================================
# VIDYASHAALE ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_USER=vidyashaale
DB_PASSWORD=vidyashaale_dev
DB_NAME=vidyashaale
DB_HOST=localhost
DB_PORT=5432

# Connection string (auto-generated from above in docker-compose)
# DATABASE_URL=postgresql://vidyashaale:vidyashaale_dev@localhost:5432/vidyashaale

# -----------------------------------------------------------------------------
# Redis (for notification queue)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# -----------------------------------------------------------------------------
# Service Ports
# -----------------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_PORT=8081
CLASS_PORT=8082
MEETING_PORT=8083
RESOURCE_PORT=8084
NOTIFICATION_PORT=8085
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Google Meet Integration
# -----------------------------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8083/auth/google/callback
GOOGLE_REFRESH_TOKEN=your-google-refresh-token

# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@vidyashaale.com

# -----------------------------------------------------------------------------
# File Storage
# -----------------------------------------------------------------------------
# Options: LOCAL, S3, MINIO
STORAGE_TYPE=LOCAL

# Local storage (when STORAGE_TYPE=LOCAL)
STORAGE_LOCAL_PATH=/data/uploads

# S3/MinIO storage (when STORAGE_TYPE=S3 or MINIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=vidyashaale
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# MinIO console
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
API_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
